# Copy to .env at your project root and GITIGNORE IT.
# Bun auto-loads .env; under Node, load it explicitly.
#
# Either credential works — set exactly one.
#
# 1. Claude Code OAuth token (subscription billing). Generate with:
#      claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# 2. Anthropic API key (API billing). Uncomment INSTEAD of the above.
#    If both are set, the runtime keeps the OAuth token and strips this one, so
#    an auth failure has a single unambiguous cause.
# ANTHROPIC_API_KEY=
